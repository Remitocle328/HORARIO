	function sma_calculateWeek(){
		var dateSelected = $('#dtpSemana').datepicker('getDate');
		var dateInit=$.datepicker.parseDate( "yy-mm-dd", lblInicia );
		var semSelected=(!dateSelected ? 0 : $.datepicker.iso8601Week(dateSelected));
		var semInit=(!dateInit ? 0 : $.datepicker.iso8601Week(dateInit));
		var semana=(!dateInit ? 0 : ''+semSelected-semInit+1);
		
		if(semana<0){
			$('#lblSemGraf').text('').hide();
			$('#semanaAcademica').val('0');
			$('div[class="scheduled"]').html('&nbsp;<br>&nbsp;<br>&nbsp;');			
			return;
		}else{
			$('#lblSemGraf').text(semana+' Semana Académica').show();
			$('#semanaAcademica').val(semana);
		}	
			
		// OJO AQUI DEBO MANDAR A LIMPIAR EL FORMULARIO
		$('.scheduled').html('&nbsp;<br>&nbsp;<br>&nbsp;');
		// OJO AQUI DEBO MANDAR A LIMPIAR EL FORMULARIO
		
		$('[id*="check_"]').each(function(){
			sma_paintSchedule(this,true);
		});
		
	} //// FIN FIN FIN FIN FIN sma_calculateWeek
	
