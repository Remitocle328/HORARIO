			//$('#lblSemGraf').focus();
			return;	
			
	} /// FIN FIN FIN FIN FIN sma_paintAllSchedule
	
	function sma_paintSchedule(elemento,con_over){
		if(!elemento)
			return;
		if($(elemento).is(':checked')){
			$(elemento).next().addClass('quitarFondo').removeClass('ui-state-default').removeClass('ui-state-active');		
			  if($(semanaAcademica).val()=='0' || $.trim($(semanaAcademica).val())=='')
				  return;
			       codmat=$(elemento).parent().children('[name="codmat"]').val();
			       nrogrp=$(elemento).parent().children('[name="nrogrp"]').val();
			       nropak=$(elemento).parent().children('[name="nropak"]').val();
			       npqmat=$(elemento).parent().children('[name="npqmat"]').val();
			       
			      var smnpgr=$(semanaAcademica).val();
			      
			      if (!codmat || !nrogrp)
			    	  return;
			      
					$.ajax({
						type : 'post',
						url : Rutac + '/Adm/ScheduleStudentsViewer',
						async : false,
						data : { codmat:codmat,nrogrp:nrogrp,smnpgr:smnpgr,agnprs:agnProceso,prdprs:prdProceso,accion:'GET_SCHEDULE',tpoform:'PGR'},
						success : function(responseJson) {
							try {
 									//console.info(responseText);
								if (responseJson=='[]')
									return

								 var copia=$('#plantillaHoraria').clone();								
								 if (!copia)
								    return
								    
								    responseJson=$.parseJSON(responseJson);
								 	var cantPda=$(responseJson).size();
								 	
									var responseText;
									var i
								    for (p=0 ;p<cantPda;p++ ){
								    			responseText=responseJson[p];									 
												var cantRow=$(responseText.daypgr).size();
												if(cantRow<=0)
													return;
												
												for (var i=0;i<cantRow;i++){
													$(copia).attr('id',responseText.nropda+'');
													$(copia).addClass('assigned');
													$(copia).find('[name="prdpda"]').val(responseText.prdpda);
													$(copia).find('[name="bgnpda"]').val(responseText.bgnpda);
													$(copia).find('[name="endpda"]').val(responseText.endpda);
													$(copia).find('[name="schpda"]').val(responseText.schpda);
													$(copia).find('[name="nropgr"]').val(responseText.nropgr[i]);
													$(copia).find('[name="nropak"]').val(nropak);
													$(copia).find('[id="deslbl"]').text(codmat+'-'+nrogrp+'     '+npqmat);
													
													// Configurando el div dentro del tooltip 
													$(copia).find('[name="fchpgr"]').val(responseText.fchpgr);
													$(copia).find('[name="nomprf"]').val(responseText.nomprf);
													$(copia).find('[name="codprf"]').val(responseText.codprf);
													$(copia).find('[name="nomsde"]').val(responseText.nomsde);
													$(copia).find('[name="nomedf"]').val(responseText.nomedf);
													$(copia).find('[name="nomaul"]').val(responseText.nomaul);
													
													var selector=responseText.daypgr[i]+'_'+responseText.horpgr[i];
													
													//console.info('selector : '+selector);
													//console.info('selectorStatic : '+selectorStatic);
													$(copia).css('background-color','#'+responseText.clrmat);
													//alert($('#plantillaHoraria').html());
													
													    $(copia).addClass('tooltip_elemento');
													$('[id="'+selector+'"]').children().html(copia);
													var copia=null;
													var copia=$('#plantillaHoraria').clone();
												}
												
								    }
									
									if(con_over){
										conf_tooltip();
										$('#smaTooltip').css('height','130px');	
									}
									
								
									return;

								} catch (e) {
								 show_message("<center class=\"caption tablas \" style=\height: 100%;font-size: medium;\" >" +e+"</center>",'','ERROR');
								 
							}

						}
					});
			  		
			  		//alert('termino');
			  		
		}			
		else{
			$(elemento).next().addClass('ui-state-default').removeClass('quitarFondo');
			nropak=$(elemento).parent().children('[name="nropak"]').val();
			// alert( nropak);
			 //alert($('input[name="nropak" value="'+nropak+'"] ').size());
			 $('input[name="nropak" ]').each(function(){
				 if($(this).val()==nropak){
					 var padre =$(this).parent();
					 if($(padre).is('div') && $(padre).hasClass('assigned')){
						 $(padre).remove();
					 }
				 }
			 });
			// AQUI MANDO A QUITAR SUS HORARIO
		}		
		return;
		
	}//// FIN FIN FIN FIN FIN DE sma_paintSchedule
	
	
    
 
